-- Copy to lua/plugins/local.lua for machine-specific tweaks. That filename is
-- gitignored, so work laptop settings never end up in the shared repo.
--
-- lazy.nvim imports every file in this directory, so anything you return here
-- is merged in as an extra plugin spec. Returning {} is fine.

