// VS Code keybindings for use with the VSCodeVim extension (vscodevim.vim).
//
// Merge into your VS Code keybindings (Ctrl+Shift+P ->
// "Preferences: Open Keyboard Shortcuts (JSON)").
//
// Pair this with vscode/settings.vscodevim.json. Do NOT also merge
// vscode/keybindings.json -- that one is for vscode-neovim.
//
// Most key routing lives in `vim.handleKeys` in the settings file. This file
// is only for the cases that list cannot express: `when`-clause conditions
// and bindings outside the text editor.
[
  // -------------------------------------------------------------------------
  // Escape: leave insert mode AND dismiss IntelliSense in one press.
  //
  // By default, Esc with the suggest widget open closes the popup but leaves
  // you in insert mode, so you have to press it twice. `runCommands` (a
  // built-in VS Code command) chains both. This is the one non-obvious
  // binding here -- delete it if it ever misbehaves and you just want the
  // stock two-press behaviour back.
  // -------------------------------------------------------------------------
  {
    "key": "escape",
    "command": "runCommands",
    "args": {
      "commands": ["hideSuggestWidget", "extension.vim_escape"]
    },
    "when": "editorTextFocus && vim.active && suggestWidgetVisible && vim.mode == 'Insert'"
  },

  // -------------------------------------------------------------------------
  // j/k navigate the file-explorer tree like a Vim list; l/h expand/collapse.
  // Not VSCodeVim -- these are plain VS Code bindings scoped to the tree, so
  // they work in the explorer, search results and the SCM view.
  // -------------------------------------------------------------------------
  { "key": "j", "command": "list.focusDown", "when": "listFocus && !inputFocus" },
  { "key": "k", "command": "list.focusUp",   "when": "listFocus && !inputFocus" },
  { "key": "l", "command": "list.expand",    "when": "listFocus && !inputFocus" },
  { "key": "h", "command": "list.collapse",  "when": "listFocus && !inputFocus" },

  // -------------------------------------------------------------------------
  // Ctrl+J / Ctrl+K move the selection in Quick Open and the suggestion
  // widget, matching the Telescope mappings in lua/plugins/telescope.lua.
  //
  // Both keys are handed back to VS Code in `vim.handleKeys`, so these are
  // free to bind. (In the terminal config they are quickfix navigation, but
  // Ctrl+K is the prefix for a whole family of VS Code chords and losing it
  // makes the editor feel broken.)
  // -------------------------------------------------------------------------
  { "key": "ctrl+j", "command": "workbench.action.quickOpenSelectNext",     "when": "inQuickOpen" },
  { "key": "ctrl+k", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen" },
  { "key": "ctrl+j", "command": "selectNextSuggestion", "when": "suggestWidgetVisible" },
  { "key": "ctrl+k", "command": "selectPrevSuggestion", "when": "suggestWidgetVisible" }
]
