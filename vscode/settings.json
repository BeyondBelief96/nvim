// Minimal Vim setup for VS Code, matching this repo's Neovim config.
// Requires the VSCodeVim extension: code --install-extension vscodevim.vim
//
// Paste into: Ctrl+Shift+P -> "Preferences: Open User Settings (JSON)"
{
  "vim.leader": "<space>",
  "vim.useSystemClipboard": true,
  "vim.hlsearch": false,
  "vim.smartcase": true,
  "vim.surround": true,
  "vim.smartRelativeLine": true,
  "vim.highlightedyank.enable": true,

  // Ctrl keys VS Code keeps. Everything else goes to Vim, so C-d, C-u, C-o,
  // C-i, C-r and C-v behave the way they do in the terminal.
  "vim.handleKeys": {
    "<C-p>": false,
    "<C-f>": false,
    "<C-b>": false,
    "<C-n>": false,
    "<C-s>": false,
    "<C-w>": false,
    "<C-k>": false,
    "<C-`>": false
  },

  "vim.normalModeKeyBindingsNonRecursive": [
    // Keep the cursor centred while scrolling and searching
    { "before": ["<C-d>"], "after": ["<C-d>", "z", "z"] },
    { "before": ["<C-u>"], "after": ["<C-u>", "z", "z"] },
    { "before": ["n"], "after": ["n", "z", "z"] },
    { "before": ["N"], "after": ["N", "z", "z"] },
    { "before": ["<Esc>"], "commands": [":nohl"] },

    // LSP
    { "before": ["g", "d"], "commands": ["editor.action.revealDefinition"] },
    { "before": ["g", "r"], "commands": ["editor.action.goToReferences"] },
    { "before": ["g", "I"], "commands": ["editor.action.goToImplementation"] },
    { "before": ["K"], "commands": ["editor.action.showHover"] },
    { "before": ["<leader>", "r", "n"], "commands": ["editor.action.rename"] },
    { "before": ["<leader>", "c", "a"], "commands": ["editor.action.quickFix"] },
    { "before": ["]", "d"], "commands": ["editor.action.marker.next"] },
    { "before": ["[", "d"], "commands": ["editor.action.marker.prev"] },

    // Find (Telescope's slot)
    { "before": ["<leader>", "p", "f"], "commands": ["workbench.action.quickOpen"] },
    { "before": ["<leader>", "p", "s"], "commands": ["workbench.action.findInFiles"] },
    { "before": ["<leader>", "p", "b"], "commands": ["workbench.action.showAllEditors"] },
    { "before": ["<leader>", "p", "v"], "commands": ["workbench.view.explorer"] },
    { "before": ["<leader>", "p", "V"], "commands": ["workbench.files.action.showActiveFileInExplorer"] },

    // Format
    { "before": ["<leader>", "f"], "commands": ["editor.action.formatDocument"] },

    // Editors and splits
    { "before": ["H"], "commands": ["workbench.action.previousEditor"] },
    { "before": ["L"], "commands": ["workbench.action.nextEditor"] },
    { "before": ["<leader>", "w", "v"], "commands": ["workbench.action.splitEditorRight"] },
    { "before": ["<leader>", "w", "s"], "commands": ["workbench.action.splitEditorDown"] },
    { "before": ["<leader>", "w", "q"], "commands": ["workbench.action.closeActiveEditor"] },

    // Panes. navigateLeft/Right step across editor groups and on out into the
    // sidebar or panel, so <C-h> from the leftmost group lands in the file tree.
    // Getting back is in keybindings.json -- Vim is not active outside an editor.
    { "before": ["<C-h>"], "commands": ["workbench.action.navigateLeft"] },
    { "before": ["<C-l>"], "commands": ["workbench.action.navigateRight"] },
    { "before": ["<leader>", "t", "t"], "commands": ["workbench.action.terminal.toggleTerminal"] },
    { "before": ["<leader>", "t", "v"], "commands": ["workbench.action.createTerminalEditorSide"] },

    // Git
    { "before": ["<leader>", "g", "g"], "commands": ["workbench.view.scm"] },
    { "before": ["]", "h"], "commands": ["workbench.action.editor.nextChange"] },
    { "before": ["[", "h"], "commands": ["workbench.action.editor.previousChange"] }
  ],

  "vim.visualModeKeyBindingsNonRecursive": [
    { "before": ["J"], "commands": ["editor.action.moveLinesDownAction"] },
    { "before": ["K"], "commands": ["editor.action.moveLinesUpAction"] },
    { "before": ["<"], "after": ["<", "g", "v"] },
    { "before": [">"], "after": [">", "g", "v"] },
    { "before": ["<leader>", "f"], "commands": ["editor.action.formatSelection"] },
    { "before": ["<leader>", "c", "a"], "commands": ["editor.action.quickFix"] }
  ],

  // Keys bound while the terminal has focus are sent to the shell unless the
  // command is listed here. These append to VS Code's defaults (which already
  // cover Ctrl+`); prefix an entry with "-" to drop a default instead.
  "terminal.integrated.commandsToSkipShell": [
    "workbench.action.focusActiveEditorGroup",
    "workbench.view.explorer"
  ],

  // Editor options from lua/core/options.lua
  "editor.lineNumbers": "relative",
  "editor.cursorSurroundingLines": 12,
  "editor.minimap.enabled": false,
  "editor.scrollBeyondLastLine": false,
  "editor.formatOnSave": true,
  "search.smartCase": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[markdown]": { "files.trimTrailingWhitespace": false }
}
