// Paste into: Ctrl+Shift+P -> "Preferences: Open Keyboard Shortcuts (JSON)"
//
// Only the things vim.handleKeys in settings.json cannot express.
[
  // Esc leaves insert mode AND dismisses IntelliSense in one press.
  {
    "key": "escape",
    "command": "runCommands",
    "args": { "commands": ["hideSuggestWidget", "extension.vim_escape"] },
    "when": "editorTextFocus && vim.active && suggestWidgetVisible && vim.mode == 'Insert'"
  },

  // j/k/l/h navigate the file tree, search results and SCM view like a Vim list.
  { "key": "j", "command": "list.focusDown", "when": "listFocus && !inputFocus" },
  { "key": "k", "command": "list.focusUp", "when": "listFocus && !inputFocus" },
  { "key": "l", "command": "list.expand", "when": "listFocus && !inputFocus" },
  { "key": "h", "command": "list.collapse", "when": "listFocus && !inputFocus" },

  // Getting back to the editor. Vim keymaps only fire inside an editor, so the
  // return leg of every hop lives here.
  //   Esc          file tree -> editor
  //   Ctrl+;       tree, search results, SCM or terminal -> editor
  //   Ctrl+h/l     step across panes from the tree, mirroring the editor maps
  // Ctrl+; is deliberate: Ctrl+h is backspace and Ctrl+l is clear-screen to a
  // shell, so neither is safe to steal while the terminal has focus.
  { "key": "escape", "command": "workbench.action.focusActiveEditorGroup", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "ctrl+;", "command": "workbench.action.focusActiveEditorGroup", "when": "listFocus && !inputFocus" },
  { "key": "ctrl+;", "command": "workbench.action.focusActiveEditorGroup", "when": "terminalFocus" },
  { "key": "ctrl+h", "command": "workbench.action.navigateLeft", "when": "listFocus && !inputFocus" },
  { "key": "ctrl+l", "command": "workbench.action.navigateRight", "when": "listFocus && !inputFocus" },

  // Ctrl+J / Ctrl+K move the selection in Quick Open and the suggest widget.
  { "key": "ctrl+j", "command": "workbench.action.quickOpenSelectNext", "when": "inQuickOpen" },
  { "key": "ctrl+k", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen" },
  { "key": "ctrl+j", "command": "selectNextSuggestion", "when": "suggestWidgetVisible" },
  { "key": "ctrl+k", "command": "selectPrevSuggestion", "when": "suggestWidgetVisible" }
]
